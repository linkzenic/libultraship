diff --git a/src/video/uikit/SDL_uikitappdelegate.m b/src/video/uikit/SDL_uikitappdelegate.m
--- a/src/video/uikit/SDL_uikitappdelegate.m
+++ b/src/video/uikit/SDL_uikitappdelegate.m
@@ -50,6 +50,8 @@ static int forward_argc;
 static char **forward_argv;
 static int exit_status;
 
+static UIWindowScene *active_window_scene;
+
 int SDL_UIKitRunApp(int argc, char *argv[], SDL_main_func mainFunction)
 {
@@ -66,7 +68,14 @@ int SDL_UIKitRunApp(int argc, char *argv[], SDL_main_func mainFunction)
 
     /* Give over control to run loop, SDLUIKitDelegate will handle most things from here */
     @autoreleasepool {
-        UIApplicationMain(argc, argv, nil, [SDLUIKitDelegate getAppDelegateClassName]);
+        NSString *delegate_name = nil;
+        if (@available(iOS 13.0, tvOS 13.0, *)) {
+            delegate_name = [SDLUIKitSceneDelegate getSceneDelegateClassName];
+        }
+        if (!delegate_name) {
+            delegate_name = [SDLUIKitDelegate getAppDelegateClassName];
+        }
+        UIApplicationMain(argc, argv, nil, delegate_name);
     }
 
     /* free the memory we used to hold copies of argc and argv */
@@ -349,6 +358,84 @@ static UIImage *SDL_LoadLaunchImageNamed(NSString *name, int screenh)
 
 @end
 
+API_AVAILABLE(ios(13.0), tvos(13.0))
+@implementation SDLUIKitSceneDelegate {
+    UIWindow *launchWindow;
+}
+
++ (NSString *)getSceneDelegateClassName
+{
+    return @"SDLUIKitSceneDelegate";
+}
+
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)connectionOptions
+{
+    if (![scene isKindOfClass:[UIWindowScene class]]) {
+        return;
+    }
+
+    active_window_scene = (UIWindowScene *)scene;
+    active_window_scene.delegate = self;
+
+    NSBundle *bundle = [NSBundle mainBundle];
+    [[NSFileManager defaultManager] changeCurrentDirectoryPath:[bundle resourcePath]];
+
+    SDL_SetMainReady();
+    [self performSelector:@selector(postFinishLaunch) withObject:nil afterDelay:0.0];
+}
+
+- (void)sceneDidBecomeActive:(UIScene *)scene
+{
+    SDL_iPhoneSetEventPump(SDL_TRUE);
+}
+
+- (void)sceneWillResignActive:(UIScene *)scene
+{
+    SDL_iPhoneSetEventPump(SDL_FALSE);
+}
+
+- (void)sceneDidEnterBackground:(UIScene *)scene
+{
+    SDL_iPhoneSetEventPump(SDL_FALSE);
+}
+
+- (void)sceneWillEnterForeground:(UIScene *)scene
+{
+    SDL_iPhoneSetEventPump(SDL_TRUE);
+}
+
+- (UISceneConfiguration *)application:(UIApplication *)application configurationForConnectingSceneSession:(UISceneSession *)connectingSceneSession options:(UISceneConnectionOptions *)options API_AVAILABLE(ios(13.0), tvos(13.0))
+{
+    UISceneConfiguration *config = [[UISceneConfiguration alloc] initWithName:@"SDLSceneConfiguration" sessionRole:connectingSceneSession.role];
+    config.delegateClass = [SDLUIKitSceneDelegate class];
+    return config;
+}
+
+- (void)postFinishLaunch
+{
+    SDL_iPhoneSetEventPump(SDL_TRUE);
+    exit_status = forward_main(forward_argc, forward_argv);
+    SDL_iPhoneSetEventPump(SDL_FALSE);
+}
+
+- (void)hideLaunchScreen
+{
+    UIWindow *window = launchWindow;
+    if (!window || window.hidden) {
+        return;
+    }
+    launchWindow = nil;
+    window.hidden = YES;
+    UIKit_ForceUpdateHomeIndicator();
+}
+
+@end
+
+UIWindowScene *UIKit_GetActiveWindowScene(void)
+{
+    return active_window_scene;
+}
+
 @implementation SDLUIKitDelegate {
     UIWindow *launchWindow;
 }
diff --git a/src/video/uikit/SDL_uikitwindow.m b/src/video/uikit/SDL_uikitwindow.m
